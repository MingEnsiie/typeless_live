{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typeless",
  "version": "0.1.0",
  "identifier": "app.typeless.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Typeless",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500
      },
      {
        "label": "floating",
        "url": "index.html",
        "width": 460,
        "height": 80,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "resizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
